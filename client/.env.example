# DuoConnect client configuration
# Leave empty to use the Vite dev proxy (recommended for local development).
# Set this when the API lives on another origin, e.g. https://api.duoconnect.app
VITE_API_URL=

# Optional WebRTC ICE servers as a JSON array. Empty uses two public Google STUN servers.
# Add TURN entries here only when calls fail across restrictive networks; rebuild after changing.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:host:3478","username":"user","credential":"secret"}]
VITE_ICE_SERVERS=

# Web Push public key from `npx web-push generate-vapid-keys` (VAPID_PUBLIC_KEY
# on the server). Baked into the client at build time. Empty disables the toggle.
VITE_VAPID_PUBLIC_KEY=
