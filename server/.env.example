# -----------------------------------------------------------------------------
# DuoConnect API — environment
# Copy to server/.env and adjust. Everything below works out of the box in dev
# using the embedded Postgres (PGlite) database.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Postgres / Supabase. Leave DATABASE_URL empty to use the embedded PGlite DB.
# Supabase example:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_SSL=true
DB_AUTO_MIGRATE=true

# Embedded database (only used when DATABASE_URL is empty)
PGLITE_DATA_DIR=.data/pglite

# Auth — use long random values in production (>= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_ME_TTL_DAYS=60
COOKIE_NAME=dc_refresh
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# Uploads. Cloudinary is used when configured, otherwise files stay on disk.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=duoconnect

# WebRTC ICE/STUN/TURN settings live on the client (VITE_ICE_SERVERS in
# client/.env), because the browser owns the peer connection. See client/.env.example.

# Optional observability
LOG_LEVEL=info
